    {
      "parameters": {
        "jsCode": "const p = $json.prefix || '/';\nconst reply = [\n  '*Ototext Bot*',\n  '',\n  `${p}help — komut listesi`,\n  `${p}ping — bot ayakta mı`,\n  `${p}status — Green API durumu`,\n  `${p}id — chatId / sender`,\n  `${p}groups — kayıtlı broadcast grupları`,\n  `${p}broadcast <mesaj> — gruplara gönder`,\n  `${p}sync — kaynak→hedef katılımcı sync başlat`,\n].join('\\n');\nreturn [{ json: { chatId: $json.chatId, reply } }];"
      },
      "id": "cmd-help",
      "name": "Help Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        -40
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { chatId: $json.chatId, reply: '🏓 pong — Ototext aktif' } }];"
      },
