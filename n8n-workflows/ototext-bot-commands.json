      "parameters": {
        "jsCode": "const p = $json.prefix || '/';\nreturn [{\n  json: {\n    chatId: $json.chatId,\n    reply: `❓ Bilinmeyen komut: ${$json.command}\\n${p}help yazarak listeyi görün.`\n  }\n}];"
      },
