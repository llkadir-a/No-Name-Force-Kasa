    {
      "parameters": {
        "jsCode": "const prev = $('Route Command').item.json;\nconst state = $json.stateInstance || JSON.stringify($json);\nreturn [{\n  json: {\n    chatId: prev.chatId,\n    reply: `📡 Ototext status\\ninstance: ${prev.instanceId}\\nstate: ${state}`\n  }\n}];"
      },
      "id": "status-text",
      "name": "Status Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    chatId: $json.chatId,\n    reply: `🆔 chatId: ${$json.chatId}\\nsender: ${$json.sender}\\nname: ${$json.senderName || '-'}`\n  }\n}];"
      },
      "id": "cmd-id",
      "name": "Id Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "const groups = $json.groups || [];\nconst reply = groups.length\n  ? `📋 Broadcast grupları (${groups.length}):\\n` + groups.map((g,i)=>`${i+1}. ${g}`).join('\\n')\n  : '📋 Kayıtlı grup yok. .env içine BROADCAST_GROUPS ekleyin veya mobil kurulum formunu kullanın.';\nreturn [{ json: { chatId: $json.chatId, reply } }];"
      },
      "id": "cmd-groups",
      "name": "Groups Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "const msg = ($json.args || '').trim();\nconst groups = $json.groups || [];\nif (!msg) {\n  return [{ json: { chatId: $json.chatId, reply: `Kullanım: ${$json.prefix}broadcast <mesaj>`, skipBroadcast: true } }];\n}\nif (!groups.length) {\n  return [{ json: { chatId: $json.chatId, reply: 'BROADCAST_GROUPS boş. Önce grup ekleyin.', skipBroadcast: true } }];\n}\nreturn groups.map((chatId, index) => ({\n  json: {\n    index: index + 1,\n    total: groups.length,\n    targetChatId: chatId,\n    message: msg,\n    replyChatId: $json.chatId,\n    skipBroadcast: false\n  }\n}));"
      },
