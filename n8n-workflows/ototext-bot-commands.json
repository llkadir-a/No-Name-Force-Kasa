    {
      "parameters": {
        "content": "## Ototext WhatsApp Bot\nGreen API webhook → prefix komutlar.\n\n**Prefix:** `$env.BOT_PREFIX` (varsayılan `/`)\n**Adminler:** `$env.BOT_ADMINS` (`905xxxxxxxxx@c.us` virgülle)\n**Gruplar:** `$env.BROADCAST_GROUPS`\n\nKomutlar: `/help` `/ping` `/status` `/id` `/groups` `/broadcast mesaj` `/sync`",
        "height": 380,
        "width": 420,
        "color": 5
      },
      "id": "sticky-bot",
      "name": "Ototext Bot",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -480,
        120
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ototext-bot",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-bot",
      "name": "Green API Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        360
      ],
      "webhookId": "ototext-bot-webhook"
    },
    {
      "parameters": {
        "jsCode": "const prefix = ($env.BOT_PREFIX || '/').toString();\nconst adminsRaw = ($env.BOT_ADMINS || '').toString();\nconst admins = adminsRaw.split(/[,;\\s]+/).map(s => s.trim()).filter(Boolean);\n\nconst body = $json.body && typeof $json.body === 'object' ? $json.body : $json;\n\nif (body.typeWebhook && body.typeWebhook !== 'incomingMessageReceived') {\n  return [];\n}\n\nconst messageData = body.messageData || {};\nconst typeMessage = messageData.typeMessage || '';\nlet text = '';\nif (typeMessage === 'textMessage') {\n  text = messageData.textMessageData?.textMessage || '';\n} else if (typeMessage === 'extendedTextMessage') {\n  text = messageData.extendedTextMessageData?.text || '';\n} else {\n  return [];\n}\n\ntext = String(text || '').trim();\nif (!text.startsWith(prefix)) {\n  return [];\n}\n\nconst rest = text.slice(prefix.length).trim();\nif (!rest) {\n  return [];\n}\n\nconst parts = rest.split(/\\s+/);\nconst command = (parts[0] || '').toLowerCase();\nconst args = rest.slice(parts[0].length).trim();\n\nconst chatId = body.senderData?.chatId || '';\nconst sender = body.senderData?.sender || chatId;\nconst isAdmin = admins.length === 0 || admins.includes(sender) || admins.includes(chatId);\n\nconst groups = ($env.BROADCAST_GROUPS || '')\n  .toString()\n  .split(/[,;\\s]+/)\n  .map(s => s.trim())\n  .filter(Boolean);\n\nreturn [{\n  json: {\n    command,\n    args,\n    text,\n    prefix,\n    chatId,\n    sender,\n    isAdmin,\n    senderName: body.senderData?.senderName || '',\n    idMessage: body.idMessage || '',\n    groups,\n    instanceId: $env.ID_INSTANCE || '',\n  }\n}];"
      },
