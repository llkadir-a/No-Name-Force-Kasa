    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst first = $('Broadcast Prepare').first().json;\nconst total = first.total || items.length;\nreturn [{\n  json: {\n    chatId: first.replyChatId,\n    reply: `✅ Broadcast tamam — ${total} gruba gönderildi.`\n  }\n}];"
      },
      "id": "bcast-done",
      "name": "Broadcast Done",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        920
      ]
    },
    {
      "parameters": {
        "jsCode": "const source = $env.SOURCE_GROUP_ID || '-';\nconst target = $env.TARGET_GROUP_ID || '-';\nreturn [{\n  json: {\n    chatId: $json.chatId,\n    reply: `🔄 Sync komutu alındı.\\nKaynak: ${source}\\nHedef: ${target}\\n\\nNot: Uzun sync için \"Ototext — Grup Katılımcı Senkronizasyonu\" workflow'unu UI'dan Manual Trigger ile çalıştırın (15 dk rate limit).`,\n    runSync: true,\n    sourceGroupId: source,\n    targetGroupId: target\n  }\n}];"
      },
